{
  "redirects": [
    { "source": "/index.html", "destination": "/", "permanent": true },
    { "source": "/projects/:project/index.html", "destination": "/:project/", "permanent": true },
    { "source": "/projects/:project", "destination": "/:project/", "permanent": true },
    { "source": "/projects/:project/", "destination": "/:project/", "permanent": true },
    { "source": "/:project", "destination": "/:project/", "permanent": false }
  ],
  "rewrites": [
    { "source": "/config.html", "destination": "/config.html" },
    { "source": "/:project/", "destination": "/projects/:project/index.html" },
    { "source": "/:project/:path*", "destination": "/projects/:project/:path*" }
  ]
}
